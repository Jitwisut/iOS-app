    "200 m or more works most reliably. A bigger zone turns lights on earlier.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รัศมี 200 ม. ขึ้นไปทำงานได้แม่นยำที่สุด ยิ่งเขตกว้าง ไฟก็ยิ่งเปิดเร็วขึ้น"
          }
        }
      }
    },
    "3D model of your home": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดล 3 มิติของบ้านคุณ"
          }
        }
      }
    },
    "A short message when lights change": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนสั้นๆ เมื่อไฟเปิดหรือปิด"
